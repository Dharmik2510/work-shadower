# Copy to infra/.env. Full list of options: server/.env.example
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=workshadower
S3_SECRET_KEY=change-me-too
# Host the Macs use to reach MinIO for presigned uploads
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000
SECRET_KEY=change-me-long-random

# Auth: dev (email login, for pilots) or oidc (company SSO)
AUTH_MODE=dev
ADMIN_EMAILS=dharmik@example.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_ADMIN_GROUP=
OIDC_TEAM_GROUP_PREFIX=

# AI: none works with no key (rule-based skill writer). Or anthropic / openai (any OpenAI-compatible URL).
LLM_PROVIDER=none
LLM_MODEL=claude-haiku-4-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_DAILY_CALLS_PER_USER=50
EMBED_PROVIDER=none
EMBED_API_KEY=

LOG_LEVEL=INFO
