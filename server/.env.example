# ---- core ----
DATABASE_URL=postgresql://postgres@localhost:5432/workshadower
DB_POOL_MIN=1
DB_POOL_MAX=10
# used to build local-storage upload URLs; derived from request if empty
PUBLIC_BASE_URL=http://localhost:8000
# comma-separated, or *
CORS_ORIGINS=http://localhost:5173
# path to built web SPA to serve at / (optional)
WEB_DIST_DIR=
LOG_LEVEL=INFO
# signs local-storage upload URLs
SECRET_KEY=change-me
# force full-text-only search
DISABLE_PGVECTOR=false

# ---- auth ----
# dev | oidc
AUTH_MODE=dev
# promoted to admin on login
ADMIN_EMAILS=dharmik@example.com
TOKEN_TTL_HOURS=720
OIDC_ISSUER=
# expected JWT audience
OIDC_CLIENT_ID=
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
# only groups with this prefix become teams
OIDC_TEAM_GROUP_PREFIX=

# ---- storage ----
# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/assets
S3_BUCKET=
S3_REGION=us-east-1
# MinIO / S3 gateway; empty for AWS
S3_ENDPOINT_URL=
# host clients use for presigned URLs, if different
S3_PUBLIC_ENDPOINT_URL=
S3_PREFIX=assets/
PRESIGN_TTL_SECONDS=900
MAX_ASSET_BYTES=2097152
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_PROFILE are read by boto3 as usual

# ---- LLM ----
# anthropic | openai | none
LLM_PROVIDER=none
LLM_MODEL=claude-haiku-4-5
LLM_API_KEY=
# default https://api.anthropic.com or https://api.openai.com/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
# USD, for usage estimates
LLM_INPUT_COST_PER_MTOK=1.0
LLM_OUTPUT_COST_PER_MTOK=5.0
LLM_DAILY_CALLS_PER_USER=50
# openai | none (vectors are 1536-dim)
EMBED_PROVIDER=none
EMBED_MODEL=text-embedding-3-small
# falls back to LLM_API_KEY
EMBED_API_KEY=
EMBED_BASE_URL=
# retries on 408/409/429/5xx/529 + transport errors (exponential backoff, honours Retry-After)
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0
# Anthropic: cache the static system prompt + tool schema
LLM_PROMPT_CACHING=true
# Anthropic Message Batches: ~50% cheaper drafts, delivered when the batch ends (usually minutes, max 24h)
LLM_BATCH_MODE=false
LLM_BATCH_POLL_SECONDS=60
LLM_BATCH_MAX_HOURS=24

# ---- relevance filter (keep / review / drop each recorded step) ----
# local = built-in rules only (free) | jev = TypeSafe Jev + rules as fallback
FILTER_PROVIDER=local
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_MAX_RETRIES=2
JEV_RETRY_BASE_SECONDS=0.25
# parallel Jev calls per recording
JEV_CONCURRENCY=8
# events beyond this use the local rules only
JEV_MAX_EVENTS=600
# neighbouring events sent as context on each side
JEV_CONTEXT_EVENTS=4
# USD, for usage estimates
JEV_INPUT_COST_PER_MTOK=0.042
# circuit breaker: open after N consecutive failures, retry after cooldown
JEV_BREAKER_FAILURES=5
JEV_BREAKER_COOLDOWN_SECONDS=60
# optional comma list; Jev picks one per recording and it becomes a tag
JEV_TASK_TYPES=
# P(new task starts) needed to split a recording into separate drafts
FILTER_SPLIT_THRESHOLD=0.85
FILTER_MIN_SEGMENT_STEPS=3
# Drop/review cut-offs and the filter kill switch are admin flags (web Admin page), not env.

# ---- jobs / worker ----
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=10
JOB_BACKOFF_MAX_SECONDS=3600
JOB_VISIBILITY_TIMEOUT_SECONDS=600
WORKER_POLL_SECONDS=2
# true = run the worker loop inside the API process (single container)
RUN_WORKER_IN_API=false
